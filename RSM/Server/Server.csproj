<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Server</AssemblyName>
    <RootNamespace>Server</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- DOT_NET selects HttpWebRequest/HttpClient path in the S2S library -->
    <DefineConstants>DOT_NET</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- csharp-s2s submodule source — always in sync, no manual copies needed -->
    <!-- GameServer.cs and RSM.cs are auto-included by the SDK from this directory -->
    <Compile Include="../../csharp-s2s/s2s_src/**/*.cs" />
    <!-- Exclude Unity-only WebGL stubs that don't compile outside Unity -->
    <Compile Remove="../../csharp-s2s/s2s_src/UnityWebSocketsForWebGL/**/*.cs" />
  </ItemGroup>

</Project>
