<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MultiPlatformXamarinExample.MainPage">
    
    <StackLayout Padding="20" VerticalOptions="Center">
        <Label Text="BrainCloud Testing" 
               FontSize="24" 
               HorizontalOptions="Center"
               Margin="0,0,0,30"/>
        
        <Button x:Name="InitButton"
                Text="Init"
                Clicked="OnInitClicked"
                BackgroundColor="#4CAF50"
                TextColor="White"
                HeightRequest="50"
                Margin="0,10"/>
        
        <Button x:Name="AuthenticateButton"
                Text="Authenticate"
                Clicked="OnAuthenticateClicked"
                BackgroundColor="#2196F3"
                TextColor="White"
                HeightRequest="50"
                Margin="0,10"/>
        
        <Label x:Name="ResultLabel"
               Text="Results will appear here"
               FontSize="14"
               Margin="0,30,0,0"
               TextColor="Gray"/>
    </StackLayout>
    
</ContentPage>