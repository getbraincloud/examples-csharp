<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>DOT_NET</DefineConstants>
    <AssemblyName>RelayTestApp</AssemblyName>
    <RootNamespace>RelayTestApp</RootNamespace>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\braincloud-csharp\BrainCloudClient\solution\vstudio\BrainCloudClient.dotnet.csproj" />
  </ItemGroup>

  <!-- Exclude old WinForms files -->
  <ItemGroup>
    <Compile Remove="FormGame.cs" />
    <Compile Remove="FormGame.Designer.cs" />
    <Compile Remove="Properties\**\*.cs" />
    <EmbeddedResource Remove="FormGame.resx" />
    <EmbeddedResource Remove="Properties\**\*.resx" />
    <None Remove="Properties\**\*.settings" />
  </ItemGroup>

  <!-- App icon (Avalonia resource for window icon) -->
  <ItemGroup>
    <AvaloniaResource Include="assets\icon.png" />
    <AvaloniaResource Include="assets\PaintSplatter1.png" />
  </ItemGroup>

  <!-- Arrow cursor images -->
  <ItemGroup>
    <Content Include="arrow*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
