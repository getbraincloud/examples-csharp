<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RelayTestApp"
    x:Class="RelayTestApp.MainWindow"
    Title="Cursor Party"
    Icon="avares://RelayTestApp/assets/icon.png"
    Width="960" Height="700"
    MinWidth="800" MinHeight="600"
    Background="#2B2B2B"
    RequestedThemeVariant="Dark">

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_App">
                <MenuItem Header="Log _Out" Name="mnuLogOut" Click="mnuLogOut_Click"
                    IsEnabled="False" />
                <Separator />
                <MenuItem Header="E_xit" Click="mnuExit_Click" />
            </MenuItem>
            <MenuItem Header="_Game">
                <MenuItem Header="_Leave" Name="mnuLeave" Click="mnuLeave_Click" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- Screen container — one child visible at a time -->
        <Grid>

            <!-- LOGIN -->
            <Grid Name="screenLogin" IsVisible="True"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cursor Party logo -->
                <Image Grid.Row="0" Grid.ColumnSpan="2"
                    Source="avares://RelayTestApp/assets/icon.png"
                    Width="220" Height="220"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12" />

                <!-- Title -->
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                    Text="Cursor Party"
                    FontSize="26" FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Margin="0,0,0,16" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" VerticalAlignment="Center"
                    Margin="0,4" />
                <TextBox Grid.Row="2" Grid.Column="1" Name="txtUsername" Margin="0,4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center"
                    Margin="0,4" />
                <TextBox Grid.Row="3" Grid.Column="1" Name="txtPassword" PasswordChar="*"
                    Margin="0,4" />

                <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Name="chkRememberMe"
                    Content="Remember Me" Margin="0,4" />

                <Button Grid.Row="5" Grid.ColumnSpan="2" Name="btnLogin"
                    Content="Login" Click="btnLogin_Click"
                    HorizontalAlignment="Stretch" Margin="0,8" />

                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Name="lblError"
                    Foreground="Red" TextWrapping="Wrap" IsVisible="False" Margin="0,4" />
            </Grid>

            <!-- LOGGING IN -->
            <Grid Name="screenLoggingIn" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Logging in..." FontSize="20" />
            </Grid>

            <!-- MAIN MENU -->
            <Grid Name="screenMainMenu" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="24">

                    <!-- Setup card -->
                    <Border Width="380" Background="#1D202C" BorderBrush="#333845"
                        BorderThickness="1" Padding="28">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Cursor Party" FontSize="26" FontWeight="Bold"
                                HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Paint more of the board than anyone else — cover it, and you win the party."
                                FontSize="12" Foreground="#66EE88" TextWrapping="Wrap"
                                TextAlignment="Center" Margin="0,0,0,12" />
                            <Separator Margin="0,0,0,12" />

                            <TextBlock Text="LOBBY TYPE" FontSize="10" FontWeight="Bold" Foreground="Gray" />
                            <ComboBox Name="cboLobbyType" HorizontalAlignment="Stretch" Margin="0,4,0,12" />

                            <TextBlock Text="NETWORK PROTOCOL" FontSize="10" FontWeight="Bold" Foreground="Gray" />
                            <!-- Displays abbreviated protocol names; btnPlay_Click maps the
                                 index back to RelayConnectionType the same way it already did. -->
                            <ComboBox Name="cboProtocol" SelectedIndex="0"
                                HorizontalAlignment="Stretch" Margin="0,4,0,12">
                                <ComboBoxItem>WS</ComboBoxItem>
                                <ComboBoxItem>TCP</ComboBoxItem>
                                <ComboBoxItem>UDP</ComboBoxItem>
                            </ComboBox>

                            <CheckBox Name="chkUsePingData" Content="With Ping Region Data"
                                IsCheckedChanged="chkUsePingData_Changed" Margin="0,0,0,12" />
                            <Separator Margin="0,0,0,12" />

                            <TextBlock Text="Not sure what any of this means? Just tap below."
                                FontSize="11" FontStyle="Italic" Foreground="Gray"
                                HorizontalAlignment="Center" Margin="0,0,0,8" />

                            <Button Name="btnPlay" Content="Find / Create Lobby" Click="btnPlay_Click"
                                HorizontalAlignment="Stretch" Padding="0,10"
                                Background="#4466EE" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Chat / Leaderboard card — independent of the Lobby screen's tabs
                         (Avalonia names are window-scoped, so this can't share those named
                         controls; it gets its own small state instead). -->
                    <Border Width="340" Height="480" Background="#1D202C" BorderBrush="#333845"
                        BorderThickness="1">
                        <TabControl>
                            <TabItem Header="Leaderboard">
                                <DockPanel Margin="8">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                        <Button Name="btnLbPointsMenu" Content="Most Beaten" Click="btnLbBoardMenu_Click" Tag="0" />
                                        <Button Name="btnLbCoverageMenu" Content="Coverage %" Click="btnLbBoardMenu_Click" Tag="1" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                        <Button Name="btnLbLifetimeMenu" Content="Lifetime" Click="btnLbPeriodMenu_Click" Tag="0" />
                                        <Button Name="btnLbQuarterlyMenu" Content="Quarterly" Click="btnLbPeriodMenu_Click" Tag="1" />
                                    </StackPanel>
                                    <ScrollViewer>
                                        <StackPanel Name="panelLeaderboardMenu" Spacing="2" />
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Chat">
                                <DockPanel Margin="8">
                                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Name="txtChatInputMenu" KeyDown="txtChatInputMenu_KeyDown" Watermark="Message..." />
                                        <Button Grid.Column="1" Content="Send" Click="btnChatSendMenu_Click" Margin="4,0,0,0" />
                                    </Grid>
                                    <ScrollViewer Name="scrollChatLogMenu">
                                        <TextBlock Name="lblChatLogMenu" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- JOINING LOBBY -->
            <Grid Name="screenJoiningLobby" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="Finding lobby..." FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Name="lblSearchTimer" FontSize="28" FontWeight="Bold"
                        HorizontalAlignment="Center" />
                    <TextBlock Name="lblLobbyStatus" FontSize="12" HorizontalAlignment="Center"
                        Foreground="Gray" />
                </StackPanel>
            </Grid>

            <!-- LOBBY -->
            <Grid Name="screenLobby" IsVisible="False" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Left: members + ping data + buttons -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Lobby ID -->
                    <TextBlock Grid.Row="0" Name="lblLobbyId"
                        FontSize="11" Foreground="Gray" Margin="0,0,0,8" />

                    <!-- Member list -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Members:" FontWeight="Bold" Margin="0,0,0,8" />
                        <StackPanel Name="panelLobbyMembers" Spacing="4" />
                        <StackPanel Name="panelPingData" Margin="0,12,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                        HorizontalAlignment="Center">
                        <Button Content="Leave" Click="btnLobbyLeave_Click" Width="80" />
                        <!-- Host: Start has no readiness gate at all — always available as an
                             early-start option. Non-host: Ready Up/Not Ready toggles only their
                             own state, never starts anything. -->
                        <Button Name="btnStart" Content="Start" Click="btnStart_Click" Width="80" />
                        <Button Name="btnReadyToggle" Content="Ready Up" Click="btnReadyToggle_Click" Width="110" />
                    </StackPanel>
                </Grid>

                <!-- Right: Chat / Leaderboards / Info tabs -->
                <TabControl Grid.Column="1">
                    <TabItem Header="Chat">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <Button Name="btnChatThisLobby" Content="This Lobby" Click="btnChatSubTab_Click" Tag="lobby" />
                                <Button Name="btnChatGlobal" Content="Global" Click="btnChatSubTab_Click" Tag="global" />
                            </StackPanel>
                            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="txtChatInput" KeyDown="txtChatInput_KeyDown" Watermark="Message..." />
                                <Button Grid.Column="1" Content="Send" Click="btnChatSend_Click" Margin="4,0,0,0" />
                            </Grid>
                            <ScrollViewer Name="scrollChatLog">
                                <TextBlock Name="lblChatLog" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Leaderboards">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                <Button Name="btnLbPoints" Content="Most Beaten" Click="btnLbBoard_Click" Tag="0" />
                                <Button Name="btnLbCoverage" Content="Coverage %" Click="btnLbBoard_Click" Tag="1" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <Button Name="btnLbLifetime" Content="Lifetime" Click="btnLbPeriod_Click" Tag="0" />
                                <Button Name="btnLbQuarterly" Content="Quarterly" Click="btnLbPeriod_Click" Tag="1" />
                            </StackPanel>
                            <ScrollViewer>
                                <StackPanel Name="panelLeaderboard" Spacing="2" />
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Info">
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock Name="lblInfoLobbyId" />
                            <TextBlock Name="lblInfoRegion" />
                            <TextBlock Name="lblInfoPlayers" />
                            <TextBlock Name="lblInfoTimeInLobby" />
                            <TextBlock Name="lblInfoStatus" Foreground="#66EE88" TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- STARTING -->
            <Grid Name="screenStarting" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="Starting..." FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Name="lblStartingTimer" FontSize="28" FontWeight="Bold"
                        HorizontalAlignment="Center" />
                    <TextBlock Name="lblStartingSubStatus" FontSize="12"
                        HorizontalAlignment="Center"
                        Foreground="Gray" />
                    <TextBlock Name="lblStartingLobbyId" FontSize="10" HorizontalAlignment="Center"
                        Foreground="#555555" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- GAME: live RANK/PLAYER/COVERAGE sidebar LEFT, header+viewport+debug RIGHT -->
            <Grid Name="screenGame" IsVisible="False" Background="#333333">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: live RANK / PLAYER / COVERAGE board (replaces the old
                     debug-controls-only HUD) -->
                <Border Grid.Column="0" Background="#2A2A2A" BorderBrush="#555555"
                    BorderThickness="0,0,1,0">
                    <DockPanel Margin="8">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="RANK / PLAYER" FontSize="10"
                                Foreground="Gray" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="COVERAGE" FontSize="10"
                                Foreground="Gray" FontWeight="Bold" />
                        </Grid>
                        <ScrollViewer>
                            <StackPanel Name="panelCoverageSidebar" Spacing="2" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Right: header (timer/ping/exit) + viewport + low-profile debug strip -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,8" ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Name="lblGameTimer" FontSize="26" FontWeight="Bold" />
                            <TextBlock Name="lblGamePing" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Name="btnExitMatch" Content="↩ Exit Match"
                            Click="btnExitMatch_Click" VerticalAlignment="Top" />
                    </Grid>

                    <local:ViewportControl Grid.Row="1" Name="viewport"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <!-- Relay debug controls — not part of the primary HUD mockup, but this
                         app exists to test relay configs, so these stay available in a
                         low-profile expander rather than being deleted outright (mirrors
                         cpp keeping an equivalent separate debug panel). -->
                    <Expander Grid.Row="2" Header="Relay debug options" IsExpanded="False"
                        Background="#2A2A2A">
                        <StackPanel Margin="8" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <CheckBox Name="chkReliable" Content="Reliable"
                                    IsCheckedChanged="chkSendOption_Changed" />
                                <CheckBox Name="chkOrdered" Content="Ordered" IsChecked="True"
                                    IsCheckedChanged="chkSendOption_Changed" />
                                <TextBlock Text="Channel:" VerticalAlignment="Center" />
                                <ComboBox Name="cboChannels" SelectedIndex="0" Width="60"
                                    SelectionChanged="cboChannels_Changed">
                                    <ComboBoxItem>0</ComboBoxItem>
                                    <ComboBoxItem>1</ComboBoxItem>
                                    <ComboBoxItem>2</ComboBoxItem>
                                    <ComboBoxItem>3</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Send splotches to:" FontSize="11" Foreground="Gray" />
                            <WrapPanel Name="panelSendMask" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </Grid>

            <!-- MATCH SUMMARY -->
            <Grid Name="screenMatchSummary" IsVisible="False" Margin="24">
                <Border Background="#1D202C" BorderBrush="#333845" BorderThickness="1"
                    MaxWidth="880" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DockPanel Margin="20">
                        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                            <TextBlock Text="Match Summary" FontSize="22" FontWeight="Bold" />
                            <TextBlock Name="lblSummarySubtitle" FontSize="11" Foreground="Gray" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top" Background="#2A2518" BorderBrush="#665533"
                            BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                            <TextBlock Name="lblSummaryWinner" FontWeight="Bold"
                                Foreground="#EEAA44" TextWrapping="Wrap" />
                        </Border>

                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,260" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="RANK / PLAYER" FontSize="10"
                                Foreground="Gray" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="COVERAGE" FontSize="10"
                                Foreground="Gray" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="LEADERBOARD RESULT" FontSize="10"
                                Foreground="Gray" FontWeight="Bold" />
                        </Grid>

                        <!-- Bottom-docked children declared buttons-first so the countdown
                             row ends up just above them, not below. -->
                        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" ColumnDefinitions="2*,1*">
                            <Button Grid.Column="0" Name="btnRematch" Content="Queue for Rematch"
                                Click="btnRematch_Click" HorizontalAlignment="Stretch"
                                Background="#4466EE" Foreground="White" FontWeight="Bold" />
                            <Button Grid.Column="1" Content="Main Menu"
                                Click="btnSummaryMainMenu_Click" HorizontalAlignment="Stretch"
                                Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock DockPanel.Dock="Bottom" Name="lblSummaryCountdown"
                            FontSize="11" Foreground="Gray" Margin="0,12,0,0" />

                        <ScrollViewer>
                            <StackPanel Name="panelSummaryRows" Spacing="8" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Version overlay — always visible, bottom-left corner -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="#AA000000" Padding="6,4" Margin="6,0,0,6"
                IsHitTestVisible="False">
                <StackPanel Spacing="1">
                    <TextBlock Name="lblVersionApp" FontSize="10" Foreground="#CCFFFFFF" />
                    <TextBlock Name="lblVersionClient" FontSize="10" Foreground="#CCFFFFFF" />
                    <TextBlock Name="lblVersionServer" FontSize="10" Foreground="#CCFFFFFF" />
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>